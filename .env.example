# Copy to .env and change the password:  Copy-Item .env.example .env
# .env is git-ignored. Never commit real credentials.

POSTGRES_USER=infrascope
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=infrascope

# Host ports (always bound to 127.0.0.1)
API_PORT=8000
WEB_PORT=3000

# Interface the API port is published on. Keep 127.0.0.1 unless another server must
# reach the API (then only behind TLS + firewall; see docs/INTEGRATIONS.md).
API_BIND=127.0.0.1

# Monitoring engine. Destinations the monitor and webhooks may contact:
# hostnames (comma-separated), plus optional specific IPs/ranges (opt-in, /16 or narrower).
ALLOWED_TARGET_HOSTS=testtarget
ALLOWED_TARGET_NETWORKS=

# Incident webhooks (leave the URL empty to disable). The secret signs every request
# with HMAC-SHA256; generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_SECRET=
MONITOR_TICK_SECONDS=1
HTTP_TIMEOUT_SECONDS=5
FAILURE_THRESHOLD=2
RECOVERY_THRESHOLD=2
LOG_LEVEL=INFO

# Test target: default delay for GET /slow
SLOW_DELAY_SECONDS=3
