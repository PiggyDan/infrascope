# Copy to .env and change the password:  Copy-Item .env.example .env
# .env is git-ignored. Never commit real credentials.

POSTGRES_USER=infrascope
POSTGRES_PASSWORD=change-me-local-dev-only
POSTGRES_DB=infrascope

# Host ports (always bound to 127.0.0.1)
API_PORT=8000
WEB_PORT=3000

# Monitoring engine
ALLOWED_TARGET_HOSTS=testtarget
MONITOR_TICK_SECONDS=1
HTTP_TIMEOUT_SECONDS=5
FAILURE_THRESHOLD=2
RECOVERY_THRESHOLD=2
LOG_LEVEL=INFO

# Test target: default delay for GET /slow
SLOW_DELAY_SECONDS=3
